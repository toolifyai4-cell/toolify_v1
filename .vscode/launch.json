{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=GitHub.copilot-chat",
        "--disable-extension=saoudrizwan.claude-dev"
      ],
      "outFiles": ["${workspaceFolder}/dist/extension.cjs"],
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Extension (Webview Hot Reload)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=GitHub.copilot-chat",
        "--disable-extension=saoudrizwan.claude-dev"
      ],
      "outFiles": ["${workspaceFolder}/dist/extension.cjs"],
      "env": {
        "TOOLIFY_WEBVIEW_DEV": "true"
      },
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal"
    }
  ]
}