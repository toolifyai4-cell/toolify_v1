{
  "name": "toolify",
  "version": "0.1.0",
  "description": "TOOLIFY - a Cline-class AI coding agent (clean-room CLI-first build)",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "bin": {
    "toolify": "./dist/index.js"
  },
  "scripts": {
    "toolify": "bun run src/index.ts",
    "chat": "bun run src/index.ts chat",
    "dev": "bun --watch run src/index.ts chat",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.6.0"
  }
}