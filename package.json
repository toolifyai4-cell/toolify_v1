{
  "name": "toolify",
  "version": "0.1.0",
  "description": "TOOLIFY - a Cline-class AI coding agent (clean-room CLI-first build)",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0",
    "vscode": "^1.85.0"
  },
  "bin": {
    "toolify": "./dist/index.js"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "toolifyChatView",
          "name": "TOOLIFY"
        }
      ]
    }
  },
  "scripts": {
    "toolify": "bun run src/index.ts",
    "chat": "bun run src/index.ts chat",
    "dev": "bun --watch run src/index.ts chat",
    "dev:webview": "cd webview-ui && npx vite",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:webview": "cd webview-ui && npx tsc --noEmit --skipLibCheck",
    "build": "npm run build:webview && esbuild src/extension.ts --bundle --platform=node --format=esm --outfile=dist/extension.js --external:vscode --external:react --external:react-reconciler --external:ink --external:react-devtools-core --external:commander --external:dotenv",
    "build:webview": "cd webview-ui && npx vite build",
    "launch": "code --extensionDevelopmentPath=. --reuse-window",
    "start": "bun run src/index.ts chat",
    "vscode": "node scripts/start.cjs",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}