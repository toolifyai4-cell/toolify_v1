{
  "name": "nexipi",
  "version": "0.1.0",
  "description": "TOOLIFY - a Cline-class AI coding agent VS Code extension",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0",
    "vscode": "^1.85.0"
  },
  "activationEvents": ["*"],
  "main": "./dist/extension.js",
  "contributes": {
    "activationEvents": ["*"],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexipi-activitybar",
          "title": "Nexipi AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nexipi-activitybar": [
        {
          "id": "nexipiChatView",
          "name": "Nexipi AI"
        }
      ]
    },
    "commands": [
      {
        "command": "nexipi.openChat",
        "title": "Nexipi: Open Chat"
      }
    ]
  },
  "scripts": {
    "dev:webview": "cd webview-ui && npx vite",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:webview": "cd webview-ui && npx tsc --noEmit --skipLibCheck",
    "build": "npm run build:webview && esbuild src/extension.ts --bundle --platform=node --format=esm --outfile=dist/extension.js --external:vscode --external:react --external:react-devtools-core --external:dotenv",
    "build:webview": "cd webview-ui && npx vite build",
    "launch": "code --extensionDevelopmentPath=. --reuse-window",
    "vscode": "node scripts/start.cjs",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@slack/webhook": "^8.0.2",
    "aws-sdk": "^2.1693.0",
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "react": "^19.3.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}