{
  "name": "toolify",
  "version": "0.1.0",
  "description": "TOOLIFY - a Cline-class AI coding agent (clean-room CLI-first build)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "toolify": "./dist/index.js"
  },
  "scripts": {
    "toolify": "tsx src/index.ts",
    "chat": "tsx src/index.ts chat",
    "test": "vitest run",
