{
  "provider": "openai",
  "baseUrl": "https://api.openai.com/v1",
  "model": "gpt-4o",
  "policy": {
    "allowlist": [
      "node *",
      "npm test*",
      "npm run *"
    ],
    "denyPaths": [
      ".env*"
    ]
  },
  "verification": {
    "commands": [
      {
        "name": "test",
        "command": "npm test"
      }
    ],
    "maxRounds": 3
  },
  "maxIterations": 40,
  "contextWindow": 128000
}
